{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "24.x",
    "pnpm": "10.33.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "baseline:prepare": "node scripts/baseline.mjs prepare",
