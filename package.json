    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.4",
    "@playwright/test": "1.64.1",
    "@types/locomotive-scroll": "4.1.4",
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "16.5.0",
    "pngjs": "7.0.0",
    "sass": "1.94.2",
    "typescript": "5.9.3"
  }
