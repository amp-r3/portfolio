    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.4",
    "@playwright/test": "1.64.1",
    "@types/locomotive-scroll": "4.1.4",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "globals": "17.13.0",
    "pngjs": "7.0.0",
    "sass": "1.106.1",
    "typescript": "6.0.3"
  }
